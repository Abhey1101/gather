{
  "name": "social-feed-backend",
  "version": "1.0.0",
  "description": "Social media backend: hybrid fan-out feed, aggregated real-time notifications, BullMQ workers",
  "type": "module",
  "engines": {
    "node": ">=20.14"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "seed": "node scripts/seed.js",
    "bench": "node scripts/benchmark.js",
    "explain": "node scripts/explain.js",
    "test": "node --test --test-force-exit tests/*.test.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cloudinary": "^2.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "pino-pretty": "^11.2.2",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.0.0"
  }
}
