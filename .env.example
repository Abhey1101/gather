NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/socialfeed
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# Authors with >= this many followers use fan-out on READ instead of fan-out on write
CELEB_THRESHOLD=10000
FEED_MAX_LEN=800
CORS_ORIGIN=*
# Set to false when running the worker as a separate process (npm run worker)
RUN_WORKER=true
RATE_LIMIT_DISABLED=false
# Optional: media uploads (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=
